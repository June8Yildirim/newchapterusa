# Copy this file to .env.local and fill in real values for local development.
# In production, set the same variables in Netlify → Site settings → Environment variables.

# Web3Forms access key (client-side)
VITE_WEB3FORMS_ACCESS_KEY=

# Admin credentials (client-side gate + server-side check in netlify/functions/content.mts)
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# MongoDB Atlas — server-side only (Netlify Functions). Never prefix with VITE_,
# or Vite will inline the secret into the browser bundle.
# Atlas → Database → Connect → Drivers → copy the SRV connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=new_chapter_b2b
# Optional: database name (defaults to "new_chapter_b2b" if unset)
MONGODB_DB=new_chapter_b2b
